# Documentation only; set these values in the shell before running run.py.
SHELTER_MODE=sqlite
PORT=8050
# Optional: defaults to enhanced/data/shelter.sqlite3, relative to the application.
# SHELTER_SQLITE_FILE=D:/data/shelter.sqlite3
# Demo JSON and historical MongoDB modes remain available for comparison.
# SHELTER_MODE=demo
# SHELTER_MODE=mongo
# MONGODB_URI=
# MONGODB_DATABASE=aac
# MONGODB_COLLECTION=animals
